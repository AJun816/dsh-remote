<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.ajun.dsh-remote-gate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness</string>
        <string>/Users/ajun/dsh-remote/gate.mjs</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Background</string>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key><string>/Users/ajun/dsh-remote/gate.log</string>
    <key>StandardErrorPath</key><string>/Users/ajun/dsh-remote/gate.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>/Users/ajun</string>
        <key>ELECTRON_RUN_AS_NODE</key><string>1</string>
    </dict>
</dict>
</plist>